# ==============================================================================
# EduGraphAI - Root Docker Ignore
# Excludes unnecessary files, local databases, build caches, and secrets
# ==============================================================================

# Version control
.git/
.gitignore
.gitattributes
.github/

# Python caches and virtual environments
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/venv*/
**/.venv*/
**/env*/

# Local databases and runtime state
**/*.db
**/*.sqlite
**/*.sqlite3

# Environment configurations and secret files
**/.env
**/.env.*
!**/.env.example

# Node.js and Next.js caches
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/*.tsbuildinfo
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Project scratch and agent artifacts
scratch/
