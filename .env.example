# ==============================================================================
# EduGraphAI - Environment Configuration Template
# Copy this file to .env before starting containers:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# Never commit .env or any file containing real passwords or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Neo4j Knowledge Graph Configuration
# ------------------------------------------------------------------------------
# Operational Mode:
#   'auto'  : Prioritize cloud AuraDB (NEO4J_URI); automatically fail over to local Neo4j (NEO4J_FALLBACK_URI)
#             if cloud instance times out or is auto-paused. (Recommended default)
#   'cloud' : Strictly connect to cloud AuraDB (no local fallback)
#   'local' : Strictly connect to local Neo4j (no cloud connection)
NEO4J_MODE=auto

# Primary Neo4j Instance (Cloud AuraDB or Docker container):
# 1. When connecting to Neo4j AuraDB (Cloud Managed):
# NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
# 2. When running with docker-compose (local container):
NEO4J_URI=bolt://neo4j:7687
# 3. When running backend locally outside Docker connecting to local Neo4j:
# NEO4J_URI=bolt://localhost:7687

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=StrongPasswordChangeMe123!
# Database name (always 'neo4j' on AuraDB Free/Professional):
NEO4J_DATABASE=neo4j

# Fallback Neo4j Instance (used automatically in 'auto' mode if cloud is paused or unreachable):
NEO4J_FALLBACK_URI=bolt://127.0.0.1:7687
NEO4J_FALLBACK_USERNAME=neo4j
NEO4J_FALLBACK_PASSWORD=StrongLocalPassword123!

# AuraDB Inactivity Keepalive:
# To prevent AuraDB Free from auto-pausing after 3 days of inactivity, run:
#   python Backend/tools/auradb_keepalive.py
# or run in background loop:
#   python Backend/tools/auradb_keepalive.py --loop --interval-hours 24

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider options:
#   'ollama'     : Local Ollama daemon (recommended for local development)
#   'groq'       : Groq Cloud API (fast OpenAI-compatible inference)
#   'openai'     : OpenAI API (gpt-4o-mini, etc.)
#   'gemini'     : Google Gemini OpenAI-compatible API (gemini-1.5-flash)
#   'openrouter' : OpenRouter API (multi-model gateway)
LLM_PROVIDER=ollama

# Model name:
# - For Ollama: llama3.2:latest
# - For Groq: llama-3.3-70b-versatile
# - For OpenAI: gpt-4o-mini
# - For Gemini: gemini-1.5-flash
# - For OpenRouter: meta-llama/llama-3.2-3b-instruct:free
LLM_MODEL=llama3.2:latest

# Base URL for OpenAI-compatible providers (leave empty to use default provider endpoint):
# - Groq: https://api.groq.com/openai/v1
# - OpenAI: https://api.openai.com/v1
# - Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# - OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# API Key for cloud LLM provider (REQUIRED if LLM_PROVIDER is not 'ollama'):
LLM_API_KEY=

# Ollama local settings (used when LLM_PROVIDER=ollama):
# On Windows/macOS Docker: host.docker.internal resolves to the host machine.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# On Linux Docker without host-gateway, use the bridge gateway IP (e.g., http://172.17.0.1:11434)
# Or if running the optional compose ollama service: http://ollama:11434
OLLAMA_MODEL=llama3.2:latest

# ------------------------------------------------------------------------------
# Backend & Security Configuration
# ------------------------------------------------------------------------------
# Production Debug mode (ALWAYS 'false' in public production deployment):
DEBUG=false

# Allowed CORS origins (comma-separated list, NO trailing slashes, NO wildcards with credentials):
# Local dev: http://localhost:3000,http://127.0.0.1:3000
# Production: https://your-domain.vercel.app,https://api.your-domain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CHANGE THIS TO A RANDOMLY GENERATED KEY IN PRODUCTION!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Persistent SQLite database path inside the backend container volume
SQLITE_DB_PATH=/app/data/knowledge_graph.db

# Backend server binding (inside container)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# The URL where the browser makes HTTP API calls to the backend
NEXT_PUBLIC_API_URL=http://localhost:8000
