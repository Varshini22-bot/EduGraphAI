# ==============================================================================
# EduGraphAI - Environment Configuration Template
# Copy this file to .env before starting containers:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# Never commit .env or any file containing real passwords or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Neo4j Knowledge Graph Configuration
# ------------------------------------------------------------------------------
# When running with docker-compose, use the container service name:
NEO4J_URI=bolt://neo4j:7687
# When running backend locally outside Docker connecting to local Neo4j:
# NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=StrongPasswordChangeMe123!

# ------------------------------------------------------------------------------
# Ollama LLM Configuration
# ------------------------------------------------------------------------------
# By default, EduGraphAI connects to Ollama running on your host machine:
# On Windows/macOS Docker: host.docker.internal resolves to the host machine.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# On Linux Docker without host-gateway, use the bridge gateway IP (e.g., http://172.17.0.1:11434)
# Or if running the optional compose ollama service: http://ollama:11434
OLLAMA_MODEL=llama3.2:latest

# ------------------------------------------------------------------------------
# Backend & Security Configuration
# ------------------------------------------------------------------------------
# CHANGE THIS TO A RANDOMLY GENERATED KEY IN PRODUCTION!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Persistent SQLite database path inside the backend container volume
SQLITE_DB_PATH=/app/data/knowledge_graph.db

# Backend server binding (inside container)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# The URL where the browser makes HTTP API calls to the backend
NEXT_PUBLIC_API_URL=http://localhost:8000
